PORT=4000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-this-with-a-long-random-secret
# Leave VITE_API_URL unset when frontend and API are deployed together on Vercel.
# Set it only when the API is deployed to a separate HTTPS host, for example:
# VITE_API_URL=https://your-api.example.com/api
# Storage mode: use "json" for local development or "mongodb" for MongoDB.
DATABASE_MODE=json
# MongoDB Atlas or local connection string. Required only for DATABASE_MODE=mongodb.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=projectpulse
